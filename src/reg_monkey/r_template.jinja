{% macro set_category_controls(fields=[], output_data_variable="df_prep_main_baseline", input_data_variable="df_prep_main_baseline") -%}
{%- if fields %}
# 将固定效应变量转换为因子变量
{% for fe in fields -%}
{{ output_data_variable }}[["{{ fe }}"]] <- as.factor({{ input_data_variable }}[["{{ fe }}"]])
{% endfor %}
