{% macro clean_sample(fields=[], input_data_variable="df_raw_main", output_data_variable="df_prep_main_baseline") -%}
# 从 {{ input_data_variable }} 读取，清洗后存入 {{ output_data_variable }}
specified_columns <- c({% for field in fields %}"{{ field }}"{% if not loop.last %}, {% endif %}{% endfor %})

rows_ok <- stats::complete.cases({{ input_data_variable }}[, specified_columns, drop = FALSE])
{{ output_data_variable }} <- {{ input_data_variable }}[rows_ok, , drop = FALSE]
{%- endmacro %}

{% macro winsorize(winsorize_percent=0.05, winsorize_fields=[], input_data_variable="df_prep_main_baseline", output_data_variable="df_prep_main_baseline") %}
# 指定需要 Winsorize 处理的列
winsorize_columns <- c("{{ winsorize_fields | join('", "') }}")

# 对 winsorize_columns 进行 Winsorize 处理
{{ output_data_variable }}[winsorize_columns] <- lapply({{ input_data_variable }}[winsorize_columns], function(x) {
  if (is.numeric(x)) {
    Winsorize(x, val = quantile(x, probs = c({{ winsorize_percent }}, {{ 1 - winsorize_percent }}), na.rm = TRUE))
  } else {
    x
  }
})
{% endmacro %}


{% macro OLS(regression_model, include_opposite=False, output_data_variable="ols_result", regression_data_variable="df_prep_main_baseline") -%}
{# ---------- 子集条件 ---------- #}
#----------------{{ regression_model.name }}----------------#
{% if regression_model.classification_field and regression_model.classification_conditions and regression_model.operator -%}
  {% set subset_condition = '(' ~ regression_model.classification_field ~ ' ' ~ regression_model.operator ~ ' ' ~ regression_model.classification_conditions ~ ')' %}
  {% set subset_statement = ', subset = ' ~ subset_condition %}
  {% set not_subset_condition = '(!' ~ subset_condition ~ ')' %}
  {% set not_subset_statement = ', subset = ' ~ not_subset_condition %}
{% endif -%}

{# ---------- 组装 RHS：X、controls、category_controls=factor(...) ---------- #}
{% set rhs = regression_model.X | join(' + ') -%}
{% if regression_model.controls -%}
  {% set rhs = rhs ~ ' + ' ~ (regression_model.controls | join(' + ')) -%}
{% endif -%}
{% if regression_model.category_controls -%}
  {% set rhs = rhs ~ ' + factor(' ~ (regression_model.category_controls | map('string') | join(') + factor(')) ~ ')' -%}
{% endif -%}

{# ---------- (1) 正向子集回归：data = {{ regression_data_variable }} ---------- #}
reg_{{ output_data_variable }} <- stats::lm({{ regression_model.y }} ~ {{ rhs }}, data = {{ regression_data_variable }}{% if subset_statement %}{{ subset_statement }}{% endif %})

{# ---------- (2) 反向子集回归（受 include_opposite 控制） ---------- #}
{% if include_opposite and (regression_model.classification_field and regression_model.classification_conditions and regression_model.operator) -%}
reg_{{ output_data_variable }}_opposite <- stats::lm({{ regression_model.y }} ~ {{ rhs }}, data = {{ regression_data_variable }}{{ not_subset_statement }})
{% endif -%}
{%- endmacro %}

{% macro fmb_regression(regression_model, include_opposite=False, output_data_variable="fmb_result", regression_data_variable="df_prep_main_baseline", entity_col=None, time_col=None, fmb_options=None, subset_condition=None, subset_condition_neg=None) -%}
#----------------{{ regression_model.name }}----------------#
fmb_data_{{ output_data_variable }} <- {{ regression_data_variable }}
{% if subset_condition %}
fmb_data_{{ output_data_variable }} <- subset(fmb_data_{{ output_data_variable }}, {{ subset_condition }})
{% endif %}

{% set rhs_terms = [] %}
{% if regression_model.X %}
  {% set rhs_terms = rhs_terms + regression_model.X %}
{% endif %}
{% if regression_model.controls %}
  {% set rhs_terms = rhs_terms + regression_model.controls %}
{% endif %}
{% if regression_model.category_controls %}
  {% set rhs_terms = rhs_terms + regression_model.category_controls %}
{% endif %}
{% if rhs_terms %}
  {% set rhs = rhs_terms | map('string') | join(' + ') %}
{% else %}
  {% set rhs = '1' %}
{% endif %}

formula_{{ output_data_variable }} <- stats::as.formula("{{ regression_model.y }} ~ {{ rhs }}")

reg_{{ output_data_variable }} <- tryCatch({
  fmb_two_pass(
    data = fmb_data_{{ output_data_variable }},
    ts_formula = formula_{{ output_data_variable }},
    identity = {{ entity_col | tojson }},
    time = {{ time_col | tojson }},
    nw_lag = {{ fmb_options.nw_lag }},
    t_type = {{ fmb_options.t_type }},
    shanken = {{ fmb_options.shanken }},
    shanken_use_factors = {{ fmb_options.shanken_factors }}
  )
}, error = function(e) list(error = conditionMessage(e)))

{% if include_opposite and subset_condition and subset_condition_neg %}
fmb_data_{{ output_data_variable }}_opp <- subset({{ regression_data_variable }}, {{ subset_condition_neg }})
reg_{{ output_data_variable }}_opposite <- tryCatch({
  fmb_two_pass(
    data = fmb_data_{{ output_data_variable }}_opp,
    ts_formula = formula_{{ output_data_variable }},
    identity = {{ entity_col | tojson }},
    time = {{ time_col | tojson }},
    nw_lag = {{ fmb_options.nw_lag }},
    t_type = {{ fmb_options.t_type }},
    shanken = {{ fmb_options.shanken }},
    shanken_use_factors = {{ fmb_options.shanken_factors }}
  )
}, error = function(e) list(error = conditionMessage(e)))
{% endif %}
{%- endmacro %}

{% macro stepwise_regression(config=None) -%}
{% if config and config.steps %}
# ============================================
# Stepwise controls for {{ config.safe_id }}
stepwise_vars_{{ config.safe_id }} <- c({{ config.all_vars | map('tojson') | join(', ') }})
df_stepwise_{{ config.safe_id }} <- {{ config.data_var }}
{% if config.subset_condition %}
df_stepwise_{{ config.safe_id }} <- subset(df_stepwise_{{ config.safe_id }}, {{ config.subset_condition }})
{% endif %}
df_stepwise_{{ config.safe_id }} <- stats::na.omit(df_stepwise_{{ config.safe_id }}[, stepwise_vars_{{ config.safe_id }}, drop = FALSE])
stepwise_results_{{ config.safe_id }} <- list()
{% for step in config.steps %}
{% set rhs_terms = (config.base_terms + step.controls) | map('string') | list %}
{% set rhs = " + ".join(rhs_terms + config.fe_terms) if (rhs_terms + config.fe_terms) else "1" %}
# Step {{ step.index }}: {{ step.label }}
{% if config.engine == 'fmb' %}
reg_{{ config.safe_id }}_step{{ step.index }} <- tryCatch({
  fmb_two_pass(
    data = df_stepwise_{{ config.safe_id }},
    ts_formula = stats::as.formula("{{ config.y_var }} ~ {{ rhs }}"),
    identity = {{ config.panel_entity | tojson }},
    time = {{ config.panel_time | tojson }},
    nw_lag = {{ config.fmb_options.nw_lag }},
    t_type = {{ config.fmb_options.t_type }},
    shanken = {{ config.fmb_options.shanken }},
    shanken_use_factors = {{ config.fmb_options.shanken_factors }}
  )
}, error = function(e) list(error = conditionMessage(e)))
{% else %}
reg_{{ config.safe_id }}_step{{ step.index }} <- {{ config.engine_fun }}({{ config.y_var }} ~ {{ rhs }}, data = df_stepwise_{{ config.safe_id }}{% if config.engine == 'plm' %}{% if config.model %}, model = "{{ config.model }}"{% endif %}{% if config.effect %}, effect = "{{ config.effect }}"{% endif %}{% endif %})
{% endif %}
{% if config.engine == 'fmb' %}
res_{{ step.index }} <- reg_{{ config.safe_id }}_step{{ step.index }}
{% else %}
res_{{ step.index }} <- {{ config.extract_fn }}(reg_{{ config.safe_id }}_step{{ step.index }})
{% endif %}
entry_{{ step.index }} <- list(
  step = {{ step.index }},
  label = "{{ step.label }}",
  controls_included = c({{ step.controls_expr }}),
  export_marked = FALSE
)
if (is.list(res_{{ step.index }})) {
  entry_{{ step.index }}$result <- res_{{ step.index }}
} else {
  entry_{{ step.index }}$message <- res_{{ step.index }}
}
stepwise_results_{{ config.safe_id }}[[length(stepwise_results_{{ config.safe_id }}) + 1]] <- entry_{{ step.index }}
{% endfor %}
{% endif %}
{%- endmacro %}

{# FE/RE (plm) 回归执行代码；data = regression_data_variable #}
{% macro plm(regression_model, include_opposite=False, output_data_variable="fe_result", regression_data_variable="df_prep_main_baseline") -%}
{# ---------- 子集条件 ---------- #}
{% if regression_model.classification_field and regression_model.classification_conditions and regression_model.operator -%}
  {% set subset_condition = '(' ~ regression_model.classification_field ~ ' ' ~ regression_model.operator ~ ' ' ~ regression_model.classification_conditions ~ ')' %}
  {% set subset_statement = ', subset = ' ~ subset_condition %}
  {% set not_subset_condition = '(!' ~ subset_condition ~ ')' %}
  {% set not_subset_statement = ', subset = ' ~ not_subset_condition %}
{% endif -%}

{# ---------- 组装 RHS：X、controls、category_controls=factor(...) ---------- #}
{% set rhs = regression_model.X | join(' + ') -%}
{% if regression_model.controls -%}
  {% set rhs = rhs ~ ' + ' ~ (regression_model.controls | join(' + ')) -%}
{% endif -%}
{% if regression_model.category_controls -%}
  {% set rhs = rhs ~ ' + factor(' ~ (regression_model.category_controls | map('string') | join(') + factor(')) ~ ')' -%}
{% endif -%}

{# ---------- 推导 model/effect ---------- #}
{% set _model_in = (regression_model.model|string|lower) if regression_model.model is defined else 'fe' %}

{% set _pid = regression_model.panel_ids if regression_model.panel_ids is defined else {} %}
{% set _id   = (_pid.entity or _pid.id or _pid.individual) if _pid else None %}
{% set _time = (_pid.time   or _pid.year or _pid.t)        if _pid else None %}
{% set _id_l   = (_id|string|lower)   if _id   is not none else '' %}
{% set _time_l = (_time|string|lower) if _time is not none else '' %}

{% set _fe_raw = regression_model.fixed_effects if regression_model.fixed_effects is defined else None %}
{% if _fe_raw is sameas(true) %}
  {% set _fe_fixed = [] %}
{% elif _fe_raw is sameas(false) or _fe_raw is none %}
  {% set _fe_fixed = [] %}
{% elif _fe_raw is string %}
  {% set _fe_fixed = [_fe_raw] %}
{% else %}
  {% set _fe_fixed = _fe_raw %}
{% endif %}
{% set _fe_fixed_l = _fe_fixed | map('string') | map('lower') | list %}
{% set _cats_l = (regression_model.category_controls or []) | map('string') | map('lower') | list %}
{% set _fe_set = (_fe_fixed_l + _cats_l) | unique %}

{% set _id_match   = (_id_l in _fe_set) %}
{% set _time_match = (_time_l in _fe_set) %}

{% if _model_in == 'ols' or _model_in == 'pooling' %}
  {% set _model_arg = 'pooling' %}
  {% set _effect_arg = none %}
{% else %}
  {% set _model_arg = 'within' %}
  {% if _time_match and not _id_match %}
    {% set _effect_arg = 'time' %}
  {% elif _id_match and not _time_match %}
    {% set _effect_arg = 'individual' %}
  {% else %}
    {% set _effect_arg = 'twoways' %}
  {% endif %}
{% endif %}

{# ---------- (1) 正向子集回归：data = {{ regression_data_variable }} ---------- #}
{% if _model_arg == 'pooling' %}
reg_{{ output_data_variable }} <- plm({{ regression_model.y }} ~ {{ rhs }}, data = {{ regression_data_variable }}, model = "pooling"{% if subset_statement %}{{ subset_statement }}{% endif %})
{% else %}
  {% if _effect_arg in ['individual','time','twoways'] %}
reg_{{ output_data_variable }} <- plm({{ regression_model.y }} ~ {{ rhs }}, data = {{ regression_data_variable }}, model = "within", effect = "{{ _effect_arg }}"{% if subset_statement %}{{ subset_statement }}{% endif %})
  {% else %}
reg_{{ output_data_variable }} <- plm({{ regression_model.y }} ~ {{ rhs }}, data = {{ regression_data_variable }}, model = "within"{% if subset_statement %}{{ subset_statement }}{% endif %})
  {% endif %}
{% endif %}

{# ---------- (2) 反向子集回归（受 include_opposite 控制） ---------- #}
{% if include_opposite and (regression_model.classification_field and regression_model.classification_conditions and regression_model.operator) -%}
  {% if _model_arg == 'pooling' %}
reg_{{ output_data_variable }}_opposite <- plm({{ regression_model.y }} ~ {{ rhs }}, data = {{ regression_data_variable }}, model = "pooling"{{ not_subset_statement }})
  {% else %}
    {% if _effect_arg in ['individual','time','twoways'] %}
reg_{{ output_data_variable }}_opposite <- plm({{ regression_model.y }} ~ {{ rhs }}, data = {{ regression_data_variable }}, model = "within", effect = "{{ _effect_arg }}"{{ not_subset_statement }})
    {% else %}
reg_{{ output_data_variable }}_opposite <- plm({{ regression_model.y }} ~ {{ rhs }}, data = {{ regression_data_variable }}, model = "within"{{ not_subset_statement }})
    {% endif %}
  {% endif %}
{% endif -%}
{%- endmacro %}
