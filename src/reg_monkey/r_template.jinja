{% macro set_panel(set_panel_fields, output_data_variable="df_prep_main_baseline", input_data_variable="df_prep_main_baseline") -%}
{{ output_data_variable }} <- pdata.frame({{ input_data_variable }}, index = c("{{ set_panel_fields.entity }}", "{{ set_panel_fields.time }}"))
